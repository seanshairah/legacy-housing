# Dedicated local development databases. Never point tests at real resident data.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/legacy_dev?schema=public"
APP_URL="http://localhost:3001"
# Generate independent 32-byte hexadecimal keys; never use examples in production.
DATA_KEY=""
FILE_KEY=""
BACKUP_KEY=""
LOCAL_DB_PASSWORD=""
LOCAL_DEMO="true"
STORAGE_ROOT=".data/private"
SCANNER_MODE="clamav"
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"
PAYNOW_MODE="disabled"
PAYNOW_INTEGRATION_ID=""
PAYNOW_INTEGRATION_KEY=""
PAYNOW_CURRENCY="USD"
RESEND_API_KEY=""
EMAIL_FROM=""
SMSPOP_API_KEY=""
SMSPOP_SENDER_ID=""

# Shared runtime is blocked until every request/job carries restricted tenant context.
TENANCY_MODE="dedicated"
# Keep disabled until approved retention policy and independent approvals exist.
RETENTION_EXECUTION_ENABLED="false"
